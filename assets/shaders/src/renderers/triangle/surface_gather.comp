#version 460 core

// performs the same kind of triangulation as get_triangulated in Helpers/triangulation.jl
// tris are created interleaved per quad, u (row) varying fastest
// it avoids having to copy the GPU buffer to the CPU, or upload a CPU index buffer for triangulation

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// input produced by tessellation, indexed by u varying
layout(std430, binding = 0) restrict readonly buffer TessellationBuffer {
    vec4 grid[]; // w is discarded, uses vec4 only to match std430 padding
};

// output, triangulated
layout(std430, binding = 1) restrict writeonly buffer CoordsBuffer {
    vec4 coords[]; // produces (x, y, z, 1.0f)
};

layout(location = 0) uniform uint vertex_count;

// naming here is a bit confusing:
// this is the width in terms of the flattened buffer memory (the number of elements in the first dimension)
// when looking at the tessellation buffer as a matrix, this is the number of rows (i.e. the height)
layout(location = 1) uniform uint grid_width;

// (du, dv), same layout as in get_triangulated
const uvec2 VERTEX_OFFSETS[6] = {
    uvec2(1, 0), uvec2(0, 0), uvec2(0, 1), // upper tri
    uvec2(1, 1), uvec2(1, 0), uvec2(0, 1)  // lower tri
};

// one invocation per output vertex
void main() {
    // flatten idx, 2D dispatch only used to reduce per-axis workgroup count for large surfaces (==> avoid hitting device limits)
    uint idx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * gl_WorkGroupSize.x + gl_LocalInvocationID.x;

    if (idx >= vertex_count) return;

    uint quad_idx = idx / 6u;

    // base (u, v) is the upper left vertex of the quad
    // (... - 1u) because # of quads is one less than # of elements per dimension
    uint base_u = quad_idx % (grid_width - 1u);
    uint base_v = quad_idx / (grid_width - 1u);

    uvec2 offsets = VERTEX_OFFSETS[idx % 6u];

    coords[idx] = vec4(grid[(base_v + offsets.y) * grid_width + base_u + offsets.x].xyz, 1.0f);
}
